[Unit]
Description=AirPods persistent local sensor daemon

[Service]
Type=simple
Environment=PATH=%h/airpods-hr-linux/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env airpods-hubd
Restart=no
KillSignal=SIGTERM
SuccessExitStatus=130 143
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
